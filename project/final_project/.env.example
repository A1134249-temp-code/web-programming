; 資料庫設定
DB_HOST="127.0.0.1"
DB_NAME="你的 DB 名稱"
DB_USER="你的 DB 使用者名稱"
DB_PASS="你的 DB 密碼"

; Gmail 信件發送 SMTP 設定
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_USERNAME="你的 Gmail"
SMTP_PASSWORD="16 碼應用程式密碼"
FROM_EMAIL="你的 Gmail"
FROM_NAME="Issue Tracker"

; 固定測試管理員設定 (出廠重設時自動寫入)
TEST_ADMIN_USER="你的測試帳號名稱"
TEST_ADMIN_EMAIL="你的測試用 Email"
TEST_ADMIN_PASS="你的測試用密碼"